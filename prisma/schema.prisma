
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model ReceiptSession {
  id String @id @default(cuid())
  createdAt DateTime @default(now())

  purchasedItems  Json? 
  recallMatches Json?

  ocrError String?
  llmError String?

  @@map("reciept_sessions")
}